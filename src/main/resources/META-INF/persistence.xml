<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
             http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd"
             version="2.1">

    <!--
        WAS JPA Persistence Unit configuration.
        JPA Provider: IBM OpenJPA (bundled with WAS 8.5.5)
        DataSource: Container-managed via JNDI
        Transaction Type: JTA (managed by WAS transaction manager)

        Migration: This file is replaced by Spring Boot autoconfiguration.
        spring.datasource.* in application.yml replaces the JNDI datasource.
        spring.jpa.* properties replace IBM OpenJPA vendor properties.
        JTA → Spring-managed transactions (@Transactional).
        IBM OpenJPA → Hibernate.
    -->

    <persistence-unit name="claimsPU" transaction-type="JTA">
        <provider>org.apache.openjpa.persistence.PersistenceProviderImpl</provider>

        <!-- WAS container-managed DataSource via JNDI -->
        <jta-data-source>jdbc/hcscClaimsDS</jta-data-source>
        <non-jta-data-source>jdbc/hcscClaimsDSNoTX</non-jta-data-source>

        <!-- Entity classes -->
        <class>com.hcsc.claims.entity.Claim</class>
        <class>com.hcsc.claims.entity.ClaimLineItem</class>
        <class>com.hcsc.claims.entity.Member</class>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- IBM OpenJPA specific properties — removed in Spring Boot (uses Hibernate) -->
            <property name="openjpa.RuntimeUnenhancedClasses" value="supported"/>
            <property name="openjpa.jdbc.DBDictionary" value="db2"/>
            <property name="openjpa.jdbc.Schema" value="HCSC_CLAIMS"/>

            <!-- Connection pooling — WAS manages this, not JPA -->
            <!-- Spring Boot: use HikariCP via spring.datasource.hikari.* -->

            <!-- Logging -->
            <property name="openjpa.Log" value="DefaultLevel=WARN,SQL=TRACE"/>

            <!-- Schema validation -->
            <property name="javax.persistence.schema-generation.database.action" value="none"/>
        </properties>
    </persistence-unit>

</persistence>
