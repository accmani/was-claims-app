<?xml version="1.0" encoding="UTF-8"?>
<web-bnd
    xmlns="http://websphere.ibm.com/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://websphere.ibm.com/xml/ns/javaee
    http://websphere.ibm.com/xml/ns/javaee/ibm-web-bnd_1_0.xsd"
    version="1.0">

    <!--
        IBM WAS binding file — maps web.xml resource refs to actual WAS resources.
        Migration: This file is completely replaced by application.yml in Spring Boot.
        Every resource-ref binding maps to a spring.* property.
    -->

    <virtual-host name="default_host"/>

    <!-- DataSource bindings: resource-ref → WAS JNDI name -->
    <resource-ref name="jdbc/hcscClaimsDS"
                  binding-name="jdbc/hcscClaimsDS"/>

    <resource-ref name="jdbc/hcscAuditDS"
                  binding-name="jdbc/hcscAuditDS"/>

    <!-- JMS bindings -->
    <resource-ref name="jms/ClaimsConnectionFactory"
                  binding-name="jms/ClaimsConnectionFactory"/>

    <!-- Security role mappings: web.xml role → WAS LDAP group -->
    <security-role name="claims-adjuster">
        <group name="HCSC_CLAIMS_ADJUSTERS"/>
    </security-role>

    <security-role name="claims-supervisor">
        <group name="HCSC_CLAIMS_SUPERVISORS"/>
    </security-role>

    <security-role name="claims-readonly">
        <group name="HCSC_CLAIMS_READONLY"/>
    </security-role>

    <security-role name="medical-review">
        <group name="HCSC_MEDICAL_REVIEW"/>
    </security-role>

</web-bnd>
