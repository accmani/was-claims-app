<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>HCSC Claims Management</display-name>
    <description>
        WebSphere Application Server deployment descriptor for HCSC Claims Management.
        Migration: This file is replaced by @SpringBootApplication and
        Spring Boot autoconfiguration. Servlet mappings move to @WebServlet / @RequestMapping.
        Security constraints move to Spring Security configuration.
        JNDI resource refs move to application.yml.
    </description>

    <!-- Session configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <tracking-mode>COOKIE</tracking-mode>
        <cookie-config>
            <http-only>true</http-only>
            <secure>true</secure>
            <name>HCSC_SESSIONID</name>
        </cookie-config>
    </session-config>

    <!-- Security constraints -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Claims API</web-resource-name>
            <url-pattern>/api/*</url-pattern>
            <http-method>GET</http-method>
            <http-method>POST</http-method>
            <http-method>PUT</http-method>
            <http-method>DELETE</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>claims-adjuster</role-name>
            <role-name>claims-supervisor</role-name>
            <role-name>claims-readonly</role-name>
            <role-name>medical-review</role-name>
        </auth-constraint>
        <user-data-constraint>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Admin API</web-resource-name>
            <url-pattern>/api/admin/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>claims-supervisor</role-name>
        </auth-constraint>
    </security-constraint>

    <!-- Login configuration — WAS handles LDAP auth -->
    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>HCSC-LDAP-Realm</realm-name>
        <form-login-config>
            <form-login-page>/login.html</form-login-page>
            <form-error-page>/login-error.html</form-error-page>
        </form-login-config>
    </login-config>

    <!-- Security roles -->
    <security-role>
        <role-name>claims-adjuster</role-name>
    </security-role>
    <security-role>
        <role-name>claims-supervisor</role-name>
    </security-role>
    <security-role>
        <role-name>claims-readonly</role-name>
    </security-role>
    <security-role>
        <role-name>medical-review</role-name>
    </security-role>

    <!-- JNDI Resource References -->
    <resource-ref>
        <description>HCSC Claims DB2 DataSource</description>
        <res-ref-name>jdbc/hcscClaimsDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
        <res-sharing-scope>Shareable</res-sharing-scope>
    </resource-ref>

    <resource-ref>
        <description>HCSC Audit DB2 DataSource</description>
        <res-ref-name>jdbc/hcscAuditDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
        <res-sharing-scope>Unshareable</res-sharing-scope>
    </resource-ref>

    <resource-ref>
        <description>IBM MQ JMS Connection Factory</description>
        <res-ref-name>jms/ClaimsConnectionFactory</res-ref-name>
        <res-type>javax.jms.ConnectionFactory</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

    <resource-env-ref>
        <description>Claims Notification Queue</description>
        <resource-env-ref-name>jms/claimsNotificationQueue</resource-env-ref-name>
        <resource-env-ref-type>javax.jms.Queue</resource-env-ref-type>
    </resource-env-ref>

    <resource-env-ref>
        <description>Payment Processing Queue</description>
        <resource-env-ref-name>jms/paymentProcessingQueue</resource-env-ref-name>
        <resource-env-ref-type>javax.jms.Queue</resource-env-ref-type>
    </resource-env-ref>

    <resource-env-ref>
        <description>Member Portal Queue</description>
        <resource-env-ref-name>jms/memberPortalQueue</resource-env-ref-name>
        <resource-env-ref-type>javax.jms.Queue</resource-env-ref-type>
    </resource-env-ref>

    <!-- Welcome files -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Error pages -->
    <error-page>
        <error-code>401</error-code>
        <location>/error/401.html</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/error/403.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.html</location>
    </error-page>

</web-app>
